{
  "name": "bomberman-2.0-e2e",
  "private": true,
  "description": "End-to-end tests for Bomberman 2.0 (Playwright)",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "check": "biome ci .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "report": "playwright show-report",
    "stack:up": "bash scripts/stack-up.sh",
    "stack:down": "bash scripts/stack-down.sh",
    "load": "node load/run.ts",
    "load:watch": "node load/watch.ts",
    "load:test": "node --test \"load/**/*.test.ts\""
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "socket.io-client": "^4.8.4"
  }
}
